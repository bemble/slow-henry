# Optional. Copy to .env (git-ignored) and mise loads it into every command in
# the repo; or set the same variables in the environment instead. When .env
# exists, its values win over the shell environment.
# Standard libpq variables: read by config (dev and prod, unless DATABASE_URL
# is set in prod) and by psql/pg_isready too.

# Database (Postgres 18 + pgvector)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=slow_henry

# Prod / Docker only. Required there: openssl rand -base64 48 (or
# mix phx.gen.secret).
# SECRET_KEY_BASE=
# PHX_HOST=localhost
# Image tag used by docker-compose.yml (default latest), e.g. 0.2 or 0.2.0.
# SLOW_HENRY_VERSION=

# Google Drive source: a "Desktop app" OAuth client (Google Cloud console,
# Drive API + Drive Labels API enabled). Connect from the UI's Settings
# page (/settings): the token it obtains is stored in DATA_DIR/secrets.toml.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, overrides the stored token:
# GOOGLE_REFRESH_TOKEN=

# The app's data dir: sources.toml, secrets.toml. Default ./data in dev.
# DATA_DIR=/var/lib/retrieval_node

# Optional: compute embeddings with Ollama (e.g. on the Mac's GPU, ~18x faster
# than the in-process CPU model). Needs `ollama pull nomic-embed-text`.
# Switching the embedding backend or model requires `mix rn.reembed`.
# OLLAMA_ENDPOINT=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# GitHub App (read-only Contents + Pull requests, device flow enabled) for
# merged PRs and private clones; connect from the Settings page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional, overrides the stored token (e.g. a fine-grained PAT):
# GITHUB_TOKEN=

# Jira Cloud ([[jira]] sources in sources.toml): enter the site, email and an
# API token on the Settings page, stored in DATA_DIR/secrets.toml.
# Optional, all three override the stored ones:
# JIRA_BASE_URL=https://my-site.atlassian.net
# JIRA_EMAIL=me@example.com
# JIRA_API_TOKEN=
